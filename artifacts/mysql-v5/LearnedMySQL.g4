grammar LearnedMySQL;

options { caseInsensitive = true; }

query: withClause? selectStatement SEMI? EOF;
withClause: 'WITH' cte (COMMA cte)*;
cte: identifier (LP identifier (COMMA identifier)* RP)? 'AS' LP selectStatement RP;
selectStatement: selectCore (setOperator selectCore)* orderBy? limitClause?;
setOperator: ('UNION' | 'INTERSECT' | 'EXCEPT') ('ALL' | 'DISTINCT')?;
selectCore: 'SELECT' 'DISTINCT'? selectItem (COMMA selectItem)* fromClause?
            ('WHERE' expression)? ('GROUP' 'BY' expression (COMMA expression)*)?
            ('HAVING' expression)?;
selectItem: STAR | expression ('AS' identifier)?;
fromClause: 'FROM' relation (COMMA relation | joinClause)*;
relation: identifier ('AS' identifier)? | LP selectStatement RP 'AS' identifier;
joinClause: ('INNER' | 'LEFT' 'OUTER'? | 'RIGHT' 'OUTER'? | 'CROSS' | 'NATURAL')?
            'JOIN' relation ('ON' expression | 'USING' LP identifier (COMMA identifier)* RP)?;
orderBy: 'ORDER' 'BY' expression ('ASC' | 'DESC')? (COMMA expression ('ASC' | 'DESC')?)*;
limitClause: 'LIMIT' integerLiteral ('OFFSET' integerLiteral | COMMA integerLiteral)?;
expression
    : ('+' | '-' | '~' | 'NOT' | '!' | 'BINARY') expression
    | expression ('*' | '/' | '%' | 'DIV' | 'MOD') expression
    | expression ('+' | '-') expression
    | expression ('<<' | '>>' | '&' | '|' | '^') expression
    | expression ('=' | '<>' | '!=' | '<' | '<=' | '>' | '>=' | '<=>') expression
    | expression 'IS' 'NOT'? ('NULL' | 'TRUE' | 'FALSE')
    | expression 'NOT'? ('LIKE' | 'REGEXP' | 'RLIKE') expression ('ESCAPE' expression)?
    | expression 'NOT'? 'BETWEEN' expression 'AND' expression
    | expression 'NOT'? 'IN' LP (selectStatement | expression (COMMA expression)*) RP
    | expression ('AND' | '&&' | 'XOR' | 'OR' | '||') expression
    | primary
    ;
primary
    : learnedPrimary
    | literal
    | identifier (DOT identifier)?
    | identifier LP ('DISTINCT'? expression (COMMA expression)* | STAR)? RP
    | LP expression RP
    | LP selectStatement RP
    | 'EXISTS' LP selectStatement RP
    | 'CASE' expression? ('WHEN' expression 'THEN' expression)+ ('ELSE' expression)? 'END'
    | 'CAST' LP expression 'AS' castType RP
    | 'CONVERT' LP expression (COMMA castType | 'USING' identifier) RP
    | 'EXTRACT' LP identifier 'FROM' expression RP
    | 'INTERVAL' expression identifier
    ;
castType: identifier (LP integerLiteral (COMMA integerLiteral)? RP)? identifier?;
literal: integerLiteral | DECIMAL | STRING | BIT_STRING | HEX_STRING | 'NULL' | 'TRUE' | 'FALSE' | '\'!\'' | '\'#\'' | '\'%D %y %a %d %m %b %j\'' | '\'%H %k %I %r %T %S %w\'' | '\'%H %k %h %I %l\'' | '\'%H:%i:%s\'' | '\'%M %d,%Y\'' | '\'%W %M %Y\'' | '\'%X %V\'' | '\'%Y-%m-%d %H:%i:%s\'' | '\'%Y-%m-%d\'' | '\'%d,%m,%Y\'' | '\'%f\'' | '\'\'' | '\'+00:00\'' | '\',\'' | '\'.*\'' | '\'00:00:00\'' | '\'1 1:1:1\'' | '\'1.999999\'' | '\'12:30:00\'' | '\'1970-01-01 00:00:00\'' | '\'1:1\'' | '\'200801\'' | '\'2024-01-15 12:30:00\'' | '\'2024-01-15\'' | '\'2024-06-30 00:00:00\'' | '\'2024-06-30\'' | '\'202401\'' | '\'2306\'' | '\'2412\'' | '\';\'' | '\'ABC\'' | '\'EUR\'' | '\'INTERNAL\'' | '\'ISO\'' | '\'JIS\'' | '\'SQL test\'' | '\'USA\'' | '\'[0-9]+\'' | '\'[[:alpha:]]+\'' | '\'[a-z]+\'' | '\'^-?[0-9]+$\'' | '\'^[0-9]{4}\'' | '\'^[a-d]\'' | '\'a%h:%i:%s\'' | '\'a\'' | '\'aaaa\'' | '\'abc\'' | '\'a{2}\'' | '\'c\'' | '\'ci\'' | '\'def\'' | '\'dog\'' | '\'hello\'' | '\'i\'' | '\'im\'' | '\'m\'' | '\'n\'' | '\'u\'' | '\'world\'' | '\'x\'' | '\'|\'' | '0' | '0.0' | '0.5' | '0x00' | '1' | '10' | '100' | '1000' | '12' | '15' | '16' | '18' | '2' | '2.0' | '2.5' | '200801' | '202401' | '2306' | '2412' | '255' | '3' | '3.14' | '36' | '4' | '42' | '5' | '511' | '6' | '65' | '7' | '700' | '8' | 'X\'00\'' | 'X\'616263\'';
identifier: IDENTIFIER | QUOTED_IDENTIFIER | 'ABS' | 'ACOS' | 'ADDDATE' | 'ADDTIME' | 'ANY_VALUE' | 'ASCII' | 'ASIN' | 'AT' | 'ATAN' | 'AVG' | 'BIN_TO_UUID' | 'BIT_AND' | 'BIT_COUNT' | 'BIT_OR' | 'BIT_XOR' | 'CEIL' | 'CEILING' | 'CHAR' | 'CHARSET' | 'CHAR_LENGTH' | 'COALESCE' | 'COERCIBILITY' | 'COLLATION' | 'CONCAT' | 'CONNECTION_ID' | 'CONV' | 'CONVERT_TZ' | 'COS' | 'COT' | 'COUNT' | 'CRC32' | 'CURDATE' | 'CURRENT_ROLE' | 'CURRENT_TIME' | 'CURRENT_TIMESTAMP' | 'CURRENT_USER' | 'CURTIME' | 'DATABASE' | 'DATE' | 'DATEDIFF' | 'DATETIME' | 'DATE_ADD' | 'DATE_FORMAT' | 'DATE_SUB' | 'DAY' | 'DAYNAME' | 'DAYOFMONTH' | 'DAYOFWEEK' | 'DAYOFYEAR' | 'DAY_MINUTE' | 'DAY_SECOND' | 'DECIMAL' | 'DEGREES' | 'DOUBLE' | 'EXP' | 'FLOOR' | 'FORMAT' | 'FOUND_ROWS' | 'FROM_DAYS' | 'FROM_UNIXTIME' | 'GET_FORMAT' | 'GREATEST' | 'GROUP_CONCAT' | 'HEX' | 'HOUR' | 'ICU_VERSION' | 'IF' | 'IFNULL' | 'INET6_ATON' | 'INET6_NTOA' | 'INET_ATON' | 'INET_NTOA' | 'ISNULL' | 'IS_IPV4' | 'IS_IPV4_COMPAT' | 'IS_IPV4_MAPPED' | 'IS_IPV6' | 'IS_UUID' | 'JSON_ARRAYAGG' | 'JSON_OBJECTAGG' | 'LAST_DAY' | 'LAST_INSERT_ID' | 'LEAST' | 'LENGTH' | 'LN' | 'LOCALTIME' | 'LOCALTIMESTAMP' | 'LOG' | 'LOG10' | 'LOG2' | 'LOWER' | 'MAKEDATE' | 'MAKETIME' | 'MAX' | 'MD5' | 'MICROSECOND' | 'MIN' | 'MINUTE' | 'MINUTE_SECOND' | 'MONTH' | 'MONTHNAME' | 'NAME_CONST' | 'NOW' | 'NULLIF' | 'OVER' | 'PARTITION' | 'PERIOD_ADD' | 'PERIOD_DIFF' | 'PI' | 'POW' | 'POWER' | 'QUARTER' | 'RADIANS' | 'RAND' | 'REGEXP_INSTR' | 'REGEXP_LIKE' | 'ROLES_GRAPHML' | 'ROUND' | 'ROW_COUNT' | 'RPAD' | 'SCHEMA' | 'SECOND' | 'SECOND_MICROSECOND' | 'SEC_TO_TIME' | 'SEPARATOR' | 'SESSION_USER' | 'SIGN' | 'SIGNED' | 'SIN' | 'SQL_TSI_YEAR' | 'SQRT' | 'STD' | 'STDDEV' | 'STDDEV_POP' | 'STDDEV_SAMP' | 'STRCMP' | 'STR_TO_DATE' | 'SUBDATE' | 'SUBSTRING' | 'SUBTIME' | 'SUM' | 'SYSDATE' | 'SYSTEM_USER' | 'TAN' | 'TIME' | 'TIMEDIFF' | 'TIMESTAMP' | 'TIMESTAMPADD' | 'TIMESTAMPDIFF' | 'TIME_FORMAT' | 'TIME_TO_SEC' | 'TO_DAYS' | 'TO_SECONDS' | 'TRUNCATE' | 'UNHEX' | 'UNIX_TIMESTAMP' | 'UNKNOWN' | 'UNSIGNED' | 'UPPER' | 'USER' | 'UTC_DATE' | 'UTC_TIME' | 'UTC_TIMESTAMP' | 'UUID' | 'UUID_SHORT' | 'UUID_TO_BIN' | 'VARIANCE' | 'VAR_POP' | 'VAR_SAMP' | 'VERSION' | 'WEEK' | 'WEEKDAY' | 'WEEKOFYEAR' | 'YEAR' | 'YEARWEEK' | 'YEAR_MONTH' | 'ZONE' | 'power_args' | 'power_base' | 'power_exp' | 'utf8mb4';

LP: '(';
RP: ')';
COMMA: ',';
DOT: '.';
SEMI: ';';
STAR: '*';
BIT_STRING: 'B' '\'' [01]* '\'' | '0B' [01]+;
HEX_STRING: 'X' '\'' [0-9a-f]* '\'' | '0X' [0-9a-f]+;
DECIMAL: ([0-9]+ '.' [0-9]* | '.' [0-9]+) ([e] [+-]? [0-9]+)? | [0-9]+ [e] [+-]? [0-9]+;
INTEGER: [0-9]+;
STRING: '\'' ('\'\'' | '\\' . | ~['\\])* '\'';
QUOTED_IDENTIFIER: '`' ('``' | ~'`')+ '`';
IDENTIFIER: [a-z_] [a-z_0-9$]*;
WS: [ \t\r\n]+ -> skip;
LINE_COMMENT: '--' [ \t] ~[\r\n]* -> skip;
BLOCK_COMMENT: '/*' .*? '*/' -> skip;

